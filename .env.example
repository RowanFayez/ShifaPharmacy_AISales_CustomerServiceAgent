# Flask
FLASK_APP=app:create_app
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///data/shifa.db

# OpenRouter (required only when LLM-backed features are implemented)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_FALLBACK_MODEL=nex-agi/nex-n2.5-mini:free

# Retrieval and cache paths
CHROMA_PERSIST_DIRECTORY=./data/chroma
LLM_CACHE_ENABLED=true
LLM_CACHE_BACKEND=sqlite
LLM_CACHE_PATH=./data/cache/llm.db
LLM_CACHE_TTL=86400
EMBEDDING_CACHE_ENABLED=true
RAG_COLLECTION_NAME=shifa_knowledge
RAG_TOP_K=4
RAG_SCORE_FLOOR=0.45
RETRIEVAL_CACHE_TTL=60

# Optional Meta Messenger bonus
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
